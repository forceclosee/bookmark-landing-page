---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

import facebookLogo from "@img/facebook-logo-secondary.png";
import XLogo from "@img/x-logo.svg";

import "@components/shared/SocialMediaIcon.css";

type Props = HTMLAttributes<"div"> & {
	className?: string;
};

const { class: className } = Astro.props;
---

<div
	class:list={[
		className,
    "social-media-icon"
	]}>
	<a
		href="https://www.facebook.com/sharer/sharer.php?u=https://bookmark-landing-page.forceclose.workers.dev/"
		target="_blank"
		rel="noreferrer noopener"
		aria-label="Share on Facebook">
		<Image
			src={facebookLogo}
			alt=""
			class="social-media-icon__icon social-media-icon__facebook-logo" />
	</a>

	<a
		href="https://twitter.com/intent/tweet?url=https://bookmark-landing-page.forceclose.workers.dev/"
		target="_blank"
		rel="noreferrer noopener"
		aria-label="Share on X">
		<XLogo class="social-media-icon__icon" aria-hidden="true" />
	</a>
</div>
