---
import "@components/shared/NavList.css";

const navLists = [
	{
		href: "/features",
		label: "Features",
	},
	{
		href: "#top",
		label: "Pricing",
	},
	{
		href: "#contact",
		label: "Contact",
	},
];

type Props = {
	variant: "light" | "dark" | "mobile";
};

const { variant } = Astro.props;
---

{navLists.map((list) =>
<li class:list={[
  "nav-list",
  {"nav-list--mobile": variant === "mobile"}
  ]}>
  <a
    href={list.href}
    class:list={[
    "nav-list__link",
    {"nav-list__link--light": variant === "light"},
    {"nav-list__link--dark": variant === "dark"},
    {"nav-list__link--mobile": variant === "mobile"}
    ]}>
    {list.label}
  </a>
</li>
)}
