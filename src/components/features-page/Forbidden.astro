---
import Button from "@components/shared/Button.astro";

import "@components/features-page/Forbidden.css";
---

<div class="forbidden__wrapper">
	<header class="forbidden__header">403</header>
	<h1 class="forbidden__title">Access Denied</h1>
	<p class="forbidden__text">To access this page you need to Login</p>
	<Button
		class="forbidden__link"
		commandfor="login-modal"
		command="show-modal"
		aria-haspopup="dialog">
		Login
	</Button>
</div>
