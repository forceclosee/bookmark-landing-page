---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";

import Footer from "@components/footer/Footer.astro";
import Header from "@components/header/Header.astro";

import "@styles/base.css";
import "@layouts/Layout.css";

type Props = {
	title: string;
};
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="slide">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<meta name="theme-color" content="#212529">

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="author" content="Force Close">
		<meta
			name="description"
			content="A full-stack application built using Astro and React, it features secure user authentication (Better Auth), serverless database integration (Neon Postgres + Drizzle ORM), accessible UI interactions (WAI-ARIA tabs and mobile drawer), and advanced styling techniques (CSS Anchor Positioning and scroll-state container queries).">

		<!-- OG Tags -->
		<meta property="og:title" content="Bookmark Landing Page">
		<meta
			property="og:description"
			content="Simple and Responsive Bookmark Landing Page with authentication and protected route">
		<meta
			property="og:image"
			content="https://res.cloudinary.com/dspqgpnvq/image/upload/v1787721444/bookmark-landing-page_elqq2n.png">
		<meta
			property="og:url"
			content="https://bookmark-landing-page.forceclose.workers.dev/">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Force Close Portfolio">

		<!-- font -->
		<Font cssVariable="--font-rubik" />

		<!-- favicon -->
		<link rel="icon" href="/icon.svg" type="image/svg+xml">

		<ClientRouter />
	</head>
	<body>
		<div class="page-wrapper">
			<Header />
			<slot />
			<Footer />
		</div>
	</body>
</html>
