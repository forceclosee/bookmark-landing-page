---
export const prerender = false;

import { auth } from "@lib/auth";

import Layout from "@layouts/Layout.astro";

import SignupForm from "@components/signup-form/SignupForm";

import "@styles/pages/signup.css";

// check user session
const session = await auth.api.getSession({
	headers: Astro.request.headers,
});

// auto rediret to homepage if the user already have session
if (session) {
	return Astro.redirect("/");
}
---

<Layout title="Sign Up - Bookmark Landing Page | Force Close">
	<main id="main" class="signup-page" data-testid="signup-page">
		<div class="signup-page__wrapper">
			<h1 class="signup-page__title">Sign up</h1>
			<SignupForm client:load />
			<p class="signup-page__text">
				Already have an account?{' '}
				{null /* Link to homepage and open login modal */}
				<a class="hover-underline signup-page__login-link" href="/?login=true"
					>Login</a
				>
			</p>
		</div>
	</main>
</Layout>
