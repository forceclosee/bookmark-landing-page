{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@components/*": ["./src/components/*"],
			"@img/*": ["./src/img/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@pages/*": ["./src/pages/*"],
			"@styles/*": ["./src/styles/*"],
			"@data/*": ["./src/data/*"],
			"@lib/*": ["./src/lib/*"],
			"@actions/*": ["./src/actions/*"],
			"@db/*": ["./src/db/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
